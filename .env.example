# Copy to .env and fill in. Never commit the real .env (it is gitignored).

# OpenRouter API key — the one metered credential. Queries the surfaces under
# test (Claude, Perplexity, ChatGPT) with web search on, runs the pinned judge
# calls, and backs the scripted off-site search in lib/openrouter-search.mjs
# (mention/SERP facts for the evidence ledgers; those checks degrade to agent
# search without it). https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional — Brave Search API (free tier): reliable Brave index-presence check
# in access-checks.mjs (the Claude-search visibility gate). Without it that one
# check reports indeterminate.
BRAVE_SEARCH_API_KEY=
